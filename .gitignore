# Mengabaikan folder vendor (dependencies dari Composer)
/vendor/

# Mengabaikan folder cache (file compile-an Blade)
/cache/

# (Opsional) Jika di dalam folder cache ada file, tapi kamu ingin foldernya tetap ada di Git
# Kamu bisa mengabaikan semua isinya kecuali file .gitkeep
# /cache/*
# !/cache/.gitkeep

# Mengabaikan file konfigurasi sensitif (jika nanti pakai file .env)
.env

# Mengabaikan file log
*.log

# Mengabaikan file sistem operasi
.DS_Store
Thumbs.db
